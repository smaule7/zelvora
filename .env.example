# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Zapier Official Agents SDK Integration (Server-Side Client Credentials)
ZAPIER_CREDENTIALS_CLIENT_ID="your-zapier-client-id"
ZAPIER_CREDENTIALS_CLIENT_SECRET="your-zapier-client-secret"

# Optional: Specific Agent ID for your existing Zelvoro Agent.
# If omitted, the server automatically queries your authorized Agents connection for "Zelvoro".
ZAPIER_AGENT_ID="your-zelvoro-agent-id"

# Supabase Direct Database Storage (Zelvoro Application Layer)
# Messages are saved directly by the application on send and receive.
VITE_SUPABASE_URL="https://xoivytxnvcluokqmgewt.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Database table for conversations & AI responses:
# public.zelvoro_messages (id, user_message, assistant_response, status, created_at)
